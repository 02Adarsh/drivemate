# ---------------------------------------------------------------------------
# DriveMate backend - copy this file to `.env` and edit the values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# DEBUG=true enables the console email backend and permissive CORS.
DEBUG=true

# Comma separated. Add your computer's LAN IP so a physical phone can reach the API.
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,10.21.188.30

# Only used when DEBUG=false.
CORS_ALLOWED_ORIGINS=

# --- Database --------------------------------------------------------------
# Development default: SQLite (leave everything empty).
# Production (PostgreSQL example):
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=drivemate
#   DB_USER=drivemate_user
#   DB_PASSWORD=strong-password
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Tokens / throttling ---------------------------------------------------
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
ANON_THROTTLE=60/minute

# --- OTP ------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Email (leave blank to print OTP codes in the server terminal) ---------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Gmail example (use an app password, never your normal password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=yourgmail@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-google-app-password
# DEFAULT_FROM_EMAIL="DriveMate <yourgmail@gmail.com>"

# --- Driver verification policy -------------------------------------------
# Comma separated. Change these per service area instead of editing code.
DRIVER_REQUIRED_DOCUMENTS=LICENCE_FRONT,LICENCE_BACK,IDENTITY
DRIVER_OPTIONAL_DOCUMENTS=ADDRESS_PROOF
DRIVER_REQUIRED_TRAINING=SAFE_DRIVING,CUSTOMER_SERVICE,VEHICLE_INSPECTION

# --- DEVELOPMENT ONLY ------------------------------------------------------
# When true (and DEBUG=true) a complete driver application is approved
# automatically, so you can test the flow without opening the admin panel.
# MUST stay false for anything real: it skips real verification.
AUTO_APPROVE_DRIVERS_IN_DEV=false

# Logging level for the accounts app: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# V9: identify explicit Nominatim lookups; use your own suitable hosted service before scaling.
GEOCODING_USER_AGENT=DriveMate/1.7 (https://github.com/02Adarsh/drivemate)
